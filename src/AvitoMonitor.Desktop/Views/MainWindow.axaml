<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvitoMonitor.Desktop.ViewModels"
        x:Class="AvitoMonitor.Desktop.Views.MainWindow"
        Title="AvitoMonitor — слежу за Авито"
        Width="1400" Height="880" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen">

  <!-- Общие стили: заголовки, подсказки, цвета «дешевле / дороже рынка» -->
  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#6B6B6B" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#C62828" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="#2E7D32" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.cheap">
      <Setter Property="Foreground" Value="#2E7D32" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.expensive">
      <Setter Property="Foreground" Value="#C62828" />
    </Style>
    <Style Selector="TextBlock.danger">
      <Setter Property="Foreground" Value="#C62828" />
    </Style>
    <Style Selector="TextBlock.warn">
      <Setter Property="Foreground" Value="#B26A00" />
    </Style>
    <Style Selector="WrapPanel > Button">
      <Setter Property="Margin" Value="0,0,6,6" />
    </Style>
  </Window.Styles>

  <!-- Как показывать выбранный поиск (правая часть вкладки «Поиски») -->
  <Window.DataTemplates>
    <DataTemplate DataType="vm:SearchItemViewModel">
      <DockPanel>

        <!-- Заголовок, статус и кнопки -->
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
          <TextBlock Classes="h1" Text="{Binding Name}" />
          <TextBlock Classes="hint" Text="{Binding CategoryTitle}" />
          <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
          <WrapPanel Margin="0,6,0,0">
            <Button Classes="accent" Content="Сканировать и следить" Command="{Binding ScanThenWatchCommand}"
                    ToolTip.Tip="Собрать все объявления, посчитать рыночные цены и сразу включить слежение" />
            <Button Content="Сканировать заново" Command="{Binding ScanCommand}"
                    ToolTip.Tip="Собрать все объявления с первой страницы" />
            <Button Content="Дособрать" Command="{Binding ContinueScanCommand}"
                    ToolTip.Tip="Продолжить сбор с места остановки" />
            <Button Content="Следить" Command="{Binding WatchCommand}"
                    ToolTip.Tip="Проверять новые объявления каждые N минут и присылать в Telegram" />
            <Button Content="Стоп" Command="{Binding StopCommand}" />
            <Button Content="Открыть в Excel" Command="{Binding OpenExcelCommand}" />
            <Button Content="Обновить" Command="{Binding ReloadCommand}" />
          </WrapPanel>
          <TextBlock Classes="hint" Text="{Binding Message}"
                     IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <TabControl SelectedIndex="{Binding SelectedTab}">

          <!-- Таблица объявлений -->
          <TabItem Header="Объявления">
            <DockPanel>
              <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,6">
                <TextBox Width="280" Text="{Binding FilterText}" Watermark="Поиск по названию, продавцу, адресу"
                         Margin="0,0,12,6" />
                <CheckBox Content="Скрыть копии и другие модели" IsChecked="{Binding HideExcluded}" Margin="0,0,12,6" />
                <CheckBox Content="Только частники" IsChecked="{Binding OnlyPrivate}" Margin="0,0,12,6" />
                <CheckBox Content="Только дешевле рынка" IsChecked="{Binding OnlyBelowMarket}" Margin="0,0,12,6" />
                <TextBlock Classes="hint" Text="{Binding ListingsCountText}" VerticalAlignment="Center" Margin="0,0,0,6" />
              </WrapPanel>

              <DataGrid ItemsSource="{Binding Listings}" IsReadOnly="True" AutoGenerateColumns="False"
                        CanUserSortColumns="True" CanUserResizeColumns="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Открыть" Command="{Binding OpenCommand}" Margin="4,2" Padding="8,2" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Группа" Binding="{Binding Group}" Width="150" />
                  <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="300" />
                  <DataGridTextColumn Header="Цена" Binding="{Binding PriceText}" SortMemberPath="Price" Width="110" />
                  <DataGridTextColumn Header="Медиана" Binding="{Binding MedianText}" SortMemberPath="Median" Width="120" />
                  <DataGridTemplateColumn Header="К рынку" SortMemberPath="Deviation" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DeviationText}" Classes.cheap="{Binding IsCheap}"
                                   Classes.expensive="{Binding IsExpensive}" VerticalAlignment="Center" Margin="12,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Пометки" SortMemberPath="Flags" Width="320">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Flags}" Classes.danger="{Binding HasDanger}" ToolTip.Tip="{Binding Flags}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Продавец" Binding="{Binding SellerName}" Width="160" />
                  <DataGridTextColumn Header="Отзывов" Binding="{Binding Reviews}" Width="90" />
                  <DataGridTemplateColumn Header="Тип продавца" SortMemberPath="SellerKind" Width="240">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding SellerKind}" ToolTip.Tip="{Binding SellerReasons}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="200" />
                  <DataGridTextColumn Header="Опубликовано" Binding="{Binding Published}" Width="130" />
                  <DataGridTextColumn Header="Замечено" Binding="{Binding FirstSeenText}" SortMemberPath="FirstSeen" Width="110" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <!-- Рыночные цены по группам -->
          <TabItem Header="Рынок">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,4,0,8">
                <TextBlock Text="{Binding MarketSummary}" TextWrapping="Wrap" />
                <TextBlock Classes="hint" Text="{Binding SellersSummary}" />
                <TextBlock Classes="hint"
                           Text="Медиана — цена «посередине». Копии, другие модели и явные выбросы (в 2,5 раза дешевле или дороже) в ней не учитываются." />
              </StackPanel>
              <DataGrid ItemsSource="{Binding Groups}" IsReadOnly="True" AutoGenerateColumns="False"
                        CanUserSortColumns="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Группа" Binding="{Binding Group}" Width="260" />
                  <DataGridTextColumn Header="Объявлений" Binding="{Binding Count}" Width="110" />
                  <DataGridTextColumn Header="Медиана" Binding="{Binding MedianText}" SortMemberPath="Median" Width="150" />
                  <DataGridTextColumn Header="Минимум" Binding="{Binding MinText}" Width="150" />
                  <DataGridTextColumn Header="Максимум" Binding="{Binding MaxText}" Width="150" />
                  <DataGridTextColumn Header="Выбросов отброшено" Binding="{Binding Outliers}" Width="170" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <!-- Редактирование поиска -->
          <TabItem Header="Изменить поиск">
            <ScrollViewer>
              <StackPanel Spacing="8" MaxWidth="1000" HorizontalAlignment="Left" Margin="0,4,8,8">

                <StackPanel DataContext="{Binding Editor}" Spacing="8">
                  <TextBlock Classes="error" IsVisible="{Binding IsLocked}"
                             Text="Идёт сбор или слежение — нажмите «Стоп», чтобы сохранить изменения." />

                  <TextBlock Text="Название поиска" />
                  <TextBox Text="{Binding Name}" Width="420" HorizontalAlignment="Left" />

                  <TextBlock Text="Категория" />
                  <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Width="420" />
                  <TextBlock Classes="hint"
                             Text="Товары — группы по памяти и шумоподавлению; недвижимость — по комнатам, сравнивается цена за м²; авто — по году выпуска." />

                  <TextBlock Classes="h2" Text="Что ищем" />
                  <TextBlock Classes="hint"
                             Text="Несколько запросов — это мультипоиск (например, отдельно iPhone 15, 16 и 17): цены сравниваются внутри каждого запроса. Если поменять слова, город или цену, собранные по запросу объявления удалятся и сбор начнётся заново." />

                  <ItemsControl ItemsSource="{Binding Sources}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                          <StackPanel Spacing="6">
                            <!-- Поиск по словам -->
                            <Grid ColumnDefinitions="*,8,200,8,110,6,110" IsVisible="{Binding IsKeyword}">
                              <TextBox Grid.Column="0" Text="{Binding Query}" Watermark="Что ищем, напр. iphone 15 128" />
                              <ComboBox Grid.Column="2" ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}"
                                        HorizontalAlignment="Stretch" />
                              <NumericUpDown Grid.Column="4" Value="{Binding PriceMin}" Watermark="от, ₽" Minimum="0"
                                             Increment="1000" FormatString="0" ShowButtonSpinner="False" />
                              <NumericUpDown Grid.Column="6" Value="{Binding PriceMax}" Watermark="до, ₽" Minimum="0"
                                             Increment="1000" FormatString="0" ShowButtonSpinner="False" />
                            </Grid>
                            <!-- Старые поиски — готовая ссылка -->
                            <TextBox Text="{Binding Url}" Watermark="https://www.avito.ru/..." IsVisible="{Binding IsUrl}" />
                            <Grid ColumnDefinitions="Auto,8,260,*,Auto,Auto">
                              <TextBlock Grid.Column="0" Text="Название:" VerticalAlignment="Center" />
                              <TextBox Grid.Column="2" Text="{Binding Label}" Watermark="Короткое название" />
                              <Button Grid.Column="4" Content="Открыть на Авито" Margin="0,0,6,0"
                                      Command="{Binding $parent[ItemsControl].DataContext.OpenOnAvitoCommand}"
                                      CommandParameter="{Binding}" />
                              <Button Grid.Column="5" Content="Удалить"
                                      Command="{Binding $parent[ItemsControl].DataContext.RemoveSourceCommand}"
                                      CommandParameter="{Binding}" />
                            </Grid>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <WrapPanel>
                    <Button Content="+ Добавить запрос" Command="{Binding AddSourceCommand}" />
                  </WrapPanel>
                  <WrapPanel>
                    <Button Classes="accent" Content="Сохранить изменения" Command="{Binding SaveCommand}" />
                    <Button Content="Отменить правки" Command="{Binding ResetCommand}" />
                  </WrapPanel>

                  <TextBlock Classes="error" Text="{Binding Errors}"
                             IsVisible="{Binding Errors, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Classes="ok" Text="{Binding Result}"
                             IsVisible="{Binding Result, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <!-- Удаление поиска — в два шага, чтобы не удалить случайно -->
                <Border Margin="0,24,0,0" Padding="10" BorderBrush="#F5C2C7" BorderThickness="1" CornerRadius="4"
                        HorizontalAlignment="Left">
                  <StackPanel Spacing="6">
                    <Button Content="Удалить поиск…" Command="{Binding RequestDeleteCommand}" IsVisible="{Binding !ConfirmDelete}" />
                    <StackPanel Spacing="6" IsVisible="{Binding ConfirmDelete}">
                      <TextBlock Text="Удалить поиск вместе со всеми собранными объявлениями?" />
                      <WrapPanel>
                        <Button Classes="accent" Content="Да, удалить" Command="{Binding ConfirmDeleteSearchCommand}" />
                        <Button Content="Нет" Command="{Binding CancelDeleteCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </DockPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <DockPanel>

    <!-- Жёлтая полоса: Авито просит пройти проверку «я не робот» -->
    <Border DockPanel.Dock="Top" Background="#FFF3CD" Padding="12,8"
            IsVisible="{Binding Banner, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Скрыть" Command="{Binding DismissBannerCommand}" />
        <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold" />
      </DockPanel>
    </Border>

    <TabControl Margin="8,4" SelectedIndex="{Binding MainTab}">

      <!-- Поиски: форма и список слева, выбранный поиск справа -->
      <TabItem Header="Поиски">
        <Grid ColumnDefinitions="330,12,*">
          <DockPanel Grid.Column="0">
            <!-- Поиск по словам: ссылку на Авито программа составит сама. Enter — «Найти». -->
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,4,0,10">
              <StackPanel.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding FindCommand}" />
              </StackPanel.KeyBindings>

              <TextBlock Classes="h2" Text="Что ищем на Авито" Margin="0" />
              <AutoCompleteBox Text="{Binding Keywords, Mode=TwoWay}" Watermark="Например: airpods 4"
                               AsyncPopulator="{Binding SuggestionsPopulator}" FilterMode="None"
                               MinimumPrefixLength="1" MinimumPopulateDelay="0:0:0.3"
                               ValueMemberBinding="{Binding Text}"
                               SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}">
                <AutoCompleteBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Margin="0,2">
                      <TextBlock Text="{Binding Text}" FontWeight="SemiBold" />
                      <TextBlock Classes="hint" FontSize="11" Text="{Binding Display}" />
                    </StackPanel>
                  </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
              </AutoCompleteBox>
              <ComboBox ItemsSource="{Binding Cities}" SelectedItem="{Binding SelectedCity}" HorizontalAlignment="Stretch" />
              <Grid ColumnDefinitions="*,6,*">
                <NumericUpDown Grid.Column="0" Value="{Binding PriceMin}" Watermark="Цена от, ₽" Minimum="0"
                               Increment="1000" FormatString="0" ShowButtonSpinner="False" />
                <NumericUpDown Grid.Column="2" Value="{Binding PriceMax}" Watermark="до, ₽" Minimum="0"
                               Increment="1000" FormatString="0" ShowButtonSpinner="False" />
              </Grid>
              <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" HorizontalAlignment="Stretch"
                        ToolTip.Tip="От категории зависит группировка и что сравнивается с рынком" />
              <CheckBox Content="После сбора следить за новыми" IsChecked="{Binding WatchAfterScan}" />
              <Button Classes="accent" Content="Найти" Command="{Binding FindCommand}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
              <TextBlock Classes="error" Text="{Binding SearchFormError}"
                         IsVisible="{Binding SearchFormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Classes="hint" FontSize="12"
                         Text="Запрос сохранится в историю. После сбора сам создастся Excel-отчёт (вкладка «Отчёты»)." />
              <TextBlock Classes="h2" Text="Мои поиски" />
            </StackPanel>

            <ListBox ItemsSource="{Binding Searches}" SelectedItem="{Binding SelectedSearch}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="2" Margin="0,4">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="hint" Text="{Binding CategoryTitle}" FontSize="12" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <Panel Grid.Column="2">
            <TextBlock Classes="hint" Text="Напишите слева, что ищем, и нажмите «Найти» — или выберите сохранённый поиск."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding SelectedSearch, Converter={x:Static ObjectConverters.IsNull}}" />
            <ContentControl Content="{Binding SelectedSearch}" />
          </Panel>
        </Grid>
      </TabItem>

      <!-- Новые объявления от слежения -->
      <TabItem Header="{Binding FeedHeader}">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,6">
            <TextBlock Classes="hint" VerticalAlignment="Center" Margin="0,0,12,6"
                       Text="Новые объявления, найденные слежением с момента запуска программы. Они же приходят в Telegram." />
            <Button Content="Очистить" Command="{Binding ClearFeedCommand}" />
          </WrapPanel>
          <ListBox ItemsSource="{Binding Feed}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PriceLine}" />
                    <TextBlock Classes="hint" Text="{Binding InfoLine}" />
                    <TextBlock Text="{Binding Flags}" Classes.danger="{Binding HasDanger}" TextWrapping="Wrap"
                               IsVisible="{Binding Flags, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Открыть" Command="{Binding OpenCommand}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <!-- История всего, что вводили в поиск (Elasticsearch / PostgreSQL) -->
      <TabItem Header="История запросов">
        <DockPanel DataContext="{Binding HistoryTab}">
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,4,0,6">
            <WrapPanel>
              <TextBox Width="360" Text="{Binding FilterText}" Watermark="Найти в истории (можно с опечатками)" Margin="0,0,12,6" />
              <Button Content="Обновить" Command="{Binding RefreshCommand}" />
            </WrapPanel>
            <TextBlock Classes="hint" Text="{Binding StatusText}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Entries}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="hint" Text="{Binding Details}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="В поле поиска" Margin="6,0" VerticalAlignment="Center"
                          Command="{Binding $parent[ListBox].DataContext.UseCommand}" CommandParameter="{Binding}" />
                  <Button Grid.Column="2" Classes="accent" Content="Искать снова" VerticalAlignment="Center"
                          Command="{Binding $parent[ListBox].DataContext.RunCommand}" CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <!-- Excel-отчёты из базы данных -->
      <TabItem Header="Отчёты">
        <DockPanel DataContext="{Binding ReportsTab}">
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,4,0,6">
            <WrapPanel>
              <TextBox Width="360" Text="{Binding FilterText}" Watermark="Фильтр по названию поиска или запросу" Margin="0,0,12,6" />
              <Button Content="Обновить" Command="{Binding LoadCommand}" />
              <Button Content="Открыть папку с отчётами" Command="{Binding OpenFolderCommand}" />
            </WrapPanel>
            <TextBlock Classes="hint" Text="{Binding StatusText}" />
          </StackPanel>
          <DataGrid ItemsSource="{Binding Items}" IsReadOnly="True" AutoGenerateColumns="False"
                    CanUserSortColumns="True" CanUserResizeColumns="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="190">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,2">
                      <Button Content="Открыть" Padding="8,2"
                              Command="{Binding $parent[DataGrid].DataContext.OpenCommand}" CommandParameter="{Binding}" />
                      <Button Content="Удалить" Padding="8,2"
                              Command="{Binding $parent[DataGrid].DataContext.DeleteCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Дата" Binding="{Binding CreatedText}" SortMemberPath="CreatedAt" Width="140" />
              <DataGridTextColumn Header="Поиск" Binding="{Binding SearchName}" Width="180" />
              <DataGridTextColumn Header="Что искали" Binding="{Binding Description}" Width="280" />
              <DataGridTextColumn Header="Объявлений" Binding="{Binding ListingsCount}" Width="110" />
              <DataGridTextColumn Header="Копий и др. моделей" Binding="{Binding ExcludedCount}" Width="160" />
              <DataGridTemplateColumn Header="Рыночные цены" SortMemberPath="Summary" Width="380">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Summary}" ToolTip.Tip="{Binding Summary}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="12,0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Файл" SortMemberPath="FileName" Width="280">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding FileName}" ToolTip.Tip="{Binding FilePath}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Margin="12,0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- Журнал — бывшая консольная версия -->
      <TabItem Header="Журнал">
        <DockPanel DataContext="{Binding Log}">
          <WrapPanel DockPanel.Dock="Top" Margin="0,4,0,6">
            <TextBlock Classes="hint" VerticalAlignment="Center" Margin="0,0,12,6"
                       Text="То же, что в окне консоли. Полный журнал с текстами ошибок — в папке logs." />
            <Button Content="Открыть папку журналов" Command="{Binding OpenLogsFolderCommand}" />
            <Button Content="Очистить" Command="{Binding ClearCommand}" />
          </WrapPanel>
          <ListBox ItemsSource="{Binding Entries}" FontFamily="Consolas, Courier New, monospace">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" Classes.danger="{Binding IsError}" Classes.warn="{Binding IsWarning}"
                           TextWrapping="Wrap" FontSize="12" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <!-- Настройки -->
      <TabItem Header="Настройки">
        <ScrollViewer DataContext="{Binding Settings}">
          <StackPanel Spacing="8" MaxWidth="820" HorizontalAlignment="Left" Margin="0,4,8,8">

            <TextBlock Classes="h1" Text="Telegram" />
            <TextBlock Text="{Binding TelegramConnectedText}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="hint"
                       Text="1. В Telegram откройте @BotFather и отправьте /newbot.  2. Задайте имя и логин бота (логин заканчивается на bot).  3. Вставьте сюда токен и нажмите «Подключить».  4. Откройте бота и нажмите «Запустить»." />
            <TextBox Text="{Binding TelegramToken}" PasswordChar="●" Watermark="Токен бота: 1234567890:AAH..." />
            <WrapPanel>
              <Button Classes="accent" Content="Подключить" Command="{Binding ConnectTelegramCommand}" />
              <Button Content="Открыть бота" Command="{Binding OpenBotCommand}"
                      IsVisible="{Binding BotLink, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <Button Content="Отменить ожидание" Command="{Binding CancelConnectCommand}" IsVisible="{Binding IsConnecting}" />
              <Button Content="Отправить тест" Command="{Binding SendTestCommand}" />
              <Button Content="Отключить" Command="{Binding DisconnectTelegramCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding TelegramStatus}" TextWrapping="Wrap" />

            <TextBlock Classes="h1" Text="Работа с Авито" Margin="0,16,0,0" />
            <DockPanel>
              <TextBlock Text="Пауза между страницами, сек" Width="360" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding DelaySeconds}" Minimum="3" Maximum="120" Increment="1" FormatString="0" Width="160"
                             HorizontalAlignment="Left" />
            </DockPanel>
            <DockPanel>
              <TextBlock Text="Проверять новые объявления каждые, мин" Width="360" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding WatchIntervalMinutes}" Minimum="2" Maximum="240" Increment="1" FormatString="0" Width="160"
                             HorizontalAlignment="Left" />
            </DockPanel>
            <DockPanel>
              <TextBlock Text="«Подозрительно дёшево» — на сколько % ниже медианы" Width="360" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding CheapPercent}" Minimum="10" Maximum="90" Increment="5" FormatString="0" Width="160"
                             HorizontalAlignment="Left" />
            </DockPanel>
            <CheckBox IsChecked="{Binding OpenNewListingsForDetails}"
                      Content="Открывать новые объявления для подробной проверки (точнее определяет магазины и агентов)" />
            <CheckBox IsChecked="{Binding HideReplicasAndOtherModels}"
                      Content="Не присылать в Telegram копии и другие модели" />
            <DockPanel>
              <TextBlock Text="Браузер" Width="360" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Browsers}" SelectedItem="{Binding SelectedBrowser}" Width="420" />
            </DockPanel>
            <CheckBox IsChecked="{Binding Headless}"
                      Content="Скрытый режим браузера (без окна; проверку «я не робот» тогда пройти нельзя)" />
            <WrapPanel>
              <Button Classes="accent" Content="Сохранить настройки" Command="{Binding SaveCommand}" />
            </WrapPanel>
            <TextBlock Classes="ok" Text="{Binding SaveResult}" />

            <TextBlock Classes="h1" Text="Базы данных" Margin="0,16,0,0" />
            <TextBlock Classes="hint"
                       Text="Запускаются командой «docker compose up -d» в папке проекта (нужен Docker Desktop). Адреса подключения — в settings.json, после изменения перезапустите программу." />
            <TextBlock Text="{Binding DatabaseStatus}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ElasticStatus}" TextWrapping="Wrap" />
            <WrapPanel>
              <Button Content="Проверить Elasticsearch и синхронизировать историю" Command="{Binding SyncElasticCommand}" />
            </WrapPanel>
            <TextBlock Classes="hint" Text="{Binding ElasticSyncResult}" />

            <TextBlock Classes="h1" Text="Данные" Margin="0,16,0,0" />
            <TextBlock Classes="hint" Text="Excel-отчёты, журналы и профиль браузера хранятся здесь (поиски и объявления — в PostgreSQL):" />
            <TextBlock Text="{Binding DataFolder}" />
            <WrapPanel>
              <Button Content="Открыть папку с данными" Command="{Binding OpenDataFolderCommand}" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
